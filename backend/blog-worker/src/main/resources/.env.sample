DATABASE_URL=jdbc:postgresql://localhost:5432/postgres?currentSchema=contentria
DATABASE_USERNAME=
DATABASE_PASSWORD=

# Cloudflare R2 Object Storage (S3-compatible credentials)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://{account_id}.r2.cloudflarestorage.com
R2_BUCKET_NAME=

# Cloudflare API (Queues http_pull — account-level token with Queues Edit permission)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_QUEUE_ID=
CLOUDFLARE_API_TOKEN=
